<Window x:Class="ReactionStudio.RecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Reaction" Height="900" Width="506"
        MinHeight="600" MinWidth="350"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}">
            <TextBlock x:Name="TitleText"
                       Text="React"
                       Foreground="{StaticResource TextBrush}"
                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                       Margin="14,0" VerticalAlignment="Center"/>
        </Border>

        <!-- Preview: 30% top / 70% bottom -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.30*"/>
                <RowDefinition Height="0.70*"/>
            </Grid.RowDefinitions>

            <!-- Webcam (you) -->
            <Border Grid.Row="0" Background="Black">
                <Grid>
                    <Image x:Name="CamImage" Stretch="UniformToFill"/>
                    <!-- REC badge -->
                    <Border x:Name="RecBadge" Visibility="Collapsed"
                            Background="#CC0F172A" CornerRadius="4"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="8" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#EF4444"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="REC" Foreground="#EF4444"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <!-- Timer -->
                    <TextBlock x:Name="TimerText" Text="0:00"
                               Foreground="{StaticResource OrangeBrush}"
                               FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,8,10,0"/>
                </Grid>
            </Border>

            <!-- Divider -->
            <Rectangle Grid.Row="0" Height="2" Fill="#FF3C3C"
                       VerticalAlignment="Bottom"/>

            <!-- Clip preview — MediaElement plays at correct speed + audio -->
            <Border Grid.Row="1" Background="Black">
                <Grid>
                    <MediaElement x:Name="ClipPlayer"
                                  Stretch="Uniform"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  MediaOpened="ClipPlayer_MediaOpened"
                                  MediaEnded="ClipPlayer_MediaEnded"/>
                    <TextBlock x:Name="PrepText"
                               Text="Loading clip…"
                               Style="{StaticResource Muted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Controls -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}">
            <Grid Margin="14,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <CheckBox x:Name="CaptionToggle" Content="Add caption text to video"
                              IsChecked="True"
                              Foreground="{StaticResource TextBrush}"
                              FontFamily="Segoe UI" FontSize="12"/>
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource Muted}"
                               Text="Get ready…" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="RecordBtn" Content="⏺  Record"
                            Style="{StaticResource BtnRed}"
                            Padding="18,9" FontSize="14" Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="RecordBtn_Click"/>
                    <Button Content="✕  Cancel" Style="{StaticResource Btn}"
                            Padding="14,9"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
