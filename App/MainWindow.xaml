<Window x:Class="ReactionStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReactionStudio"
        Title="Reaction Studio" Height="620" Width="820"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <local:PercentToArcConverter x:Key="Arc" Size="26" Radius="10"/>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>
        <local:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- header -->
            <RowDefinition Height="62"/>   <!-- url bar -->
            <RowDefinition Height="*"/>    <!-- clip list -->
            <RowDefinition Height="58"/>   <!-- action bar -->
            <RowDefinition Height="28"/>   <!-- status -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}">
            <Grid Margin="16,0">
                <TextBlock Text="🎬  Reaction Studio" Style="{StaticResource H1}"
                           VerticalAlignment="Center"/>
                <Button Content="⚙  Settings" Style="{StaticResource Btn}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="12,6" FontSize="12"
                        Click="Settings_Click"/>
            </Grid>
        </Border>

        <!-- URL input -->
        <Grid Grid.Row="1" Margin="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <!-- TextBox + placeholder overlay -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <TextBox x:Name="UrlBox"
                         Style="{StaticResource DarkBox}"
                         VerticalAlignment="Center"
                         KeyDown="UrlBox_KeyDown"/>
                <TextBlock IsHitTestVisible="False"
                           Text="Paste an Instagram or YouTube URL…"
                           Foreground="{StaticResource MutedBrush}"
                           FontFamily="Segoe UI" FontSize="13"
                           VerticalAlignment="Center" Margin="12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=UrlBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="1" Content="⬇  Download"
                    Style="{StaticResource BtnAccent}"
                    VerticalAlignment="Center"
                    Click="Download_Click"/>
        </Grid>

        <!-- Clip list -->
        <ListView x:Name="ClipList" Grid.Row="2"
                  Margin="16,0" Padding="0"
                  Background="{StaticResource CardBrush}"
                  BorderThickness="0"
                  Foreground="{StaticResource TextBrush}"
                  FontFamily="Segoe UI" FontSize="13"
                  SelectionMode="Single"
                  MouseDoubleClick="ClipList_DoubleClick">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding"         Value="12,6"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2D3F55"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3B4F6B"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Clip" Width="400"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Size" Width="70"
                                    DisplayMemberBinding="{Binding Size}"/>
                    <GridViewColumn Header="Duration" Width="80"
                                    DisplayMemberBinding="{Binding Duration}"/>
                    <GridViewColumn Header="Script" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Progress ring (while generating) -->
                                    <Grid Width="26" Height="26" Margin="0,0,8,0"
                                          Visibility="{Binding IsGenerating, Converter={StaticResource BoolVis}}">
                                        <Ellipse Width="26" Height="26"
                                                 Stroke="#334155" StrokeThickness="3"/>
                                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="{Binding Progress, Converter={StaticResource Arc}}"/>
                                        <TextBlock Text="{Binding ProgressText}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontFamily="Segoe UI" FontSize="9"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Status text (when idle) -->
                                    <TextBlock Text="{Binding ScriptStatus}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Visibility="{Binding IsGenerating, Converter={StaticResource BoolVisInv}}"/>

                                    <!-- Per-row regenerate -->
                                    <Button Content="↻"
                                            Style="{StaticResource Btn}"
                                            Padding="7,2" FontSize="13"
                                            ToolTip="Regenerate script for this clip"
                                            Click="RowRegen_Click"
                                            IsEnabled="{Binding NotGenerating}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Action bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    Margin="16,8" VerticalAlignment="Center">
            <Button Content="⏺  React (you)" Style="{StaticResource BtnGreen}"
                    FontSize="14" Padding="16,9" Margin="0,0,8,0"
                    ToolTip="Record yourself reacting (live webcam / potato filter)"
                    Click="React_Click"/>
            <Button Content="🎙  AI Commentary" Style="{StaticResource BtnAccent}"
                    FontSize="14" Padding="16,9" Margin="0,0,8,0"
                    ToolTip="Your character + ElevenLabs voiceover + captions (no webcam)"
                    Click="Commentary_Click"/>
            <Button Content="🗑  Delete" Style="{StaticResource Btn}"
                    Foreground="#F87171" Margin="0,0,8,0"
                    Click="Delete_Click"/>
            <Button Content="📂  Clips Folder" Style="{StaticResource Btn}"
                    Margin="0,0,8,0" Click="OpenFolder_Click"/>
            <Button Content="🔄" Style="{StaticResource Btn}"
                    Padding="10,8" Click="Refresh_Click"/>
        </StackPanel>

        <!-- Status bar -->
        <TextBlock x:Name="StatusText" Grid.Row="4"
                   Style="{StaticResource Muted}"
                   Text="Ready" Margin="18,4"
                   VerticalAlignment="Center"/>
    </Grid>
</Window>
