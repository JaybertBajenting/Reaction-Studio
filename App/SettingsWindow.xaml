<Window x:Class="ReactionStudio.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="560" Width="520"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,20"/>

            <!-- Camera selector -->
            <TextBlock Text="Camera source (pick Snap Camera):" Style="{StaticResource Muted}"/>
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CameraCombo" Grid.Column="0" Height="38"
                          Style="{StaticResource DarkCombo}"/>
                <Button Grid.Column="2" Content="🔄 Scan" Style="{StaticResource Btn}"
                        Padding="12,7" Click="ScanCameras_Click"/>
            </Grid>
            <TextBlock Style="{StaticResource Muted}" Foreground="#475569"
                       Text="Tip: open Snap Camera first, then click Scan"/>

            <!-- Microphone selector -->
            <TextBlock Text="Microphone (your voice):" Style="{StaticResource Muted}" Margin="0,20,0,0"/>
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MicCombo" Grid.Column="0" Height="38"
                          Style="{StaticResource DarkCombo}"/>
                <Button Grid.Column="2" Content="🔄 Scan" Style="{StaticResource Btn}"
                        Padding="12,7" Click="ScanMics_Click"/>
            </Grid>

            <!-- Voice volume -->
            <Grid Margin="0,20,0,0">
                <TextBlock Text="Voice volume:" Style="{StaticResource Muted}"/>
                <TextBlock x:Name="VolLabel" Text="200%"
                           Foreground="{StaticResource AccentBrush}"
                           FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Right"/>
            </Grid>
            <Slider x:Name="VolSlider" Margin="0,6,0,0"
                    Minimum="0.5" Maximum="4.0" SmallChange="0.05" LargeChange="0.25"
                    TickFrequency="0.25" IsSnapToTickEnabled="False"
                    ValueChanged="VolSlider_Changed"/>
            <TextBlock Style="{StaticResource Muted}" Foreground="#475569"
                       Text="How loud your mic is mixed over the clip audio (100% = unchanged)."/>

            <!-- Auto-blur profanity -->
            <CheckBox x:Name="BlurProfanityToggle" Content="Auto-blur swear words baked into the clip"
                      Margin="0,20,0,0" IsChecked="True"
                      Foreground="{StaticResource TextBrush}"
                      FontFamily="Segoe UI" FontSize="13"/>
            <TextBlock Style="{StaticResource Muted}" Foreground="#475569"
                       Text="Codex finds on-screen profanity in the clip and blurs it (helps avoid age-restriction)."/>

            <!-- Voice captions -->
            <CheckBox x:Name="AutoCaptionsToggle" Content="Auto-captions from my voice (Whisper)"
                      Margin="0,20,0,0" IsChecked="True"
                      Foreground="{StaticResource TextBrush}"
                      FontFamily="Segoe UI" FontSize="13"/>
            <TextBlock Style="{StaticResource Muted}" Foreground="#475569"
                       Text="Transcribes your mic and burns animated word-captions onto the video."/>

            <!-- Scheduled publishing -->
            <CheckBox x:Name="ScheduleToggle" Content="Auto-publish at peak times (2× per day)"
                      Margin="0,20,0,0" IsChecked="True"
                      Foreground="{StaticResource TextBrush}"
                      FontFamily="Segoe UI" FontSize="13"/>
            <TextBlock Style="{StaticResource Muted}" Foreground="#475569"
                       Text="Uploads stay private, then auto-go public at the next peak slot (US Eastern). Queues 2/day."/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Day hour (0-23):" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="DayHourBox" Grid.Column="1" Style="{StaticResource DarkBox}" Height="34"/>
                <TextBlock Grid.Column="3" Text="Night hour:" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="NightHourBox" Grid.Column="4" Style="{StaticResource DarkBox}" Height="34"/>
            </Grid>
            <TextBlock Style="{StaticResource Muted}" Foreground="#475569" Margin="0,4,0,0"
                       Text="Times are US Eastern, 24-hour (e.g. 12 = noon, 21 = 9 PM)."/>

            <!-- Style reference -->
            <TextBlock Text="Style reference — learn from a channel's top Shorts:"
                       Style="{StaticResource Muted}" Margin="0,22,0,0"/>
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="StyleUrlBox" Grid.Column="0" Style="{StaticResource DarkBox}" Height="38"/>
                <Button x:Name="LearnBtn" Grid.Column="2" Content="📚 Learn"
                        Style="{StaticResource Btn}" Padding="12,7" Click="Learn_Click"/>
            </Grid>
            <Grid>
                <TextBlock x:Name="StyleStatus" Style="{StaticResource Muted}" Foreground="#475569"
                           Text="Paste a channel URL (e.g. youtube.com/@handle) and click Learn."/>
                <Button x:Name="ClearStyleBtn" Content="clear" Style="{StaticResource Btn}"
                        Padding="8,2" FontSize="11" HorizontalAlignment="Right"
                        Click="ClearStyle_Click"/>
            </Grid>

            <!-- AI Character Commentary -->
            <Border Background="#172033" CornerRadius="8" Padding="14" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="🎙  AI Character Commentary"
                               Foreground="{StaticResource TextBrush}"
                               FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"/>

                    <TextBlock Text="ElevenLabs API key — paste here:"
                               Style="{StaticResource Muted}" Margin="0,12,0,2"/>
                    <TextBox x:Name="ElevenKeyBox" Style="{StaticResource DarkBox}" Height="36"/>

                    <TextBlock Text="ElevenLabs Voice ID — paste here:"
                               Style="{StaticResource Muted}" Margin="0,10,0,2"/>
                    <TextBox x:Name="VoiceIdBox" Style="{StaticResource DarkBox}" Height="36"/>

                    <TextBlock Text="Your character — use your own image (best quality):"
                               Style="{StaticResource Muted}" Margin="0,12,0,2"/>
                    <Button x:Name="PickCharBtn" Content="📁  Use my own image…" Style="{StaticResource BtnAccent}"
                            Padding="14,8" HorizontalAlignment="Left" Click="PickChar_Click"/>

                    <TextBlock Text="…or have Codex draw a quick flat one (describe it):"
                               Style="{StaticResource Muted}" Margin="0,12,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CharDescBox" Grid.Column="0" Style="{StaticResource DarkBox}" Height="36"/>
                        <Button x:Name="GenCharBtn" Grid.Column="2" Content="✨ Generate" Style="{StaticResource Btn}"
                                Padding="12,7" Click="GenChar_Click"/>
                    </Grid>
                    <TextBlock x:Name="CharStatus" Style="{StaticResource Muted}" Foreground="#475569"
                               Margin="0,6,0,0" Text="No character yet."/>
                    <Image x:Name="CharPreview" Height="90" HorizontalAlignment="Left" Margin="0,8,0,0"
                           Stretch="Uniform" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- YouTube credentials -->
            <TextBlock Text="YouTube — place client_secret.json here:"
                       Style="{StaticResource Muted}" Margin="0,20,0,0"/>
            <TextBlock x:Name="SecretPathText" Margin="0,6,0,0"
                       Foreground="{StaticResource AccentBrush}"
                       FontFamily="Segoe UI" FontSize="11"
                       TextWrapping="Wrap" Cursor="Hand"
                       MouseLeftButtonUp="SecretPath_Click"/>
        </StackPanel>
        </ScrollViewer>

        <!-- Save -->
        <Button Grid.Row="1" Content="Save" Style="{StaticResource BtnAccent}"
                HorizontalAlignment="Left" Padding="24,9" FontSize="14"
                Margin="0,20,0,0" Click="Save_Click"/>
    </Grid>
</Window>
